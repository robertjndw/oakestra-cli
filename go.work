go 1.25.0

use (
	./oak_go_cli
	./oakestra-go
)

// oak_go_cli/go.mod requires oakestra-go v0.1.0, which hasn't been tagged
// yet. The `use` directive above should be enough on its own, but Go's
// module graph loading still reaches out to the network to resolve that
// version once there's more than one external dependency in the graph.
// This pins it to the local checkout so builds work before the tag exists.
// Safe to remove once oakestra-go/v0.1.0 is tagged; harmless to leave, since
// go.work is a local dev file that never affects consumers of either module.
replace github.com/oakestra/oakestra-cli/oakestra-go v0.1.0 => ./oakestra-go
